@using FridgeManager.Services

<div class="food-card @(Expired ? "food-card-expired" : null)">
    <a class="food-card-link" href="@($"food/{Item.Id}")">
        <div class="food-card-plate">
            <img src="@FoodDisplay.ImageUrl(Item)" alt="" />
        </div>
        <div class="food-card-head">
            <h3 class="food-card-title">@Item.Name</h3>
            <span class="fm-tag @BadgeClass">@FoodDisplay.BadgeLabel(_state)</span>
        </div>
        <div class="food-card-body">
            <span>@FoodDisplay.OwnerLabel(Item.Owner) · @Item.Category</span>
            <span class="fig @(Expired ? "is-expired" : null)">
                @(Expired ? "Expired" : "Expires") @FoodDisplay.DateLabel(Item.ExpirationDate) · @FoodDisplay.SizeLabel(Item.SizeUnits)
            </span>
        </div>
    </a>
    <div class="food-card-meta">
        <span>@Item.Shelf.Name</span>
        @if (CanDiscard)
        {
            <button type="button" class="fm-btn fm-btn-ghost" @onclick="OnDiscard">Discard</button>
        }
        else if (Item.IsShared)
        {
            <span class="fm-tag fm-tag-outline">Shared</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public FoodItem Item { get; set; } = default!;

    [Parameter]
    public DateOnly Today { get; set; }

    [Parameter]
    public bool CanDiscard { get; set; }

    [Parameter]
    public EventCallback OnDiscard { get; set; }

    private ExpiryState _state;

    private bool Expired => _state == ExpiryState.Expired;

    private string BadgeClass => _state switch
    {
        ExpiryState.ExpiringSoon => "fm-tag-accent",
        ExpiryState.Expired => "fm-tag-danger",
        _ => "fm-tag-neutral"
    };

    protected override void OnParametersSet()
    {
        _state = ExpiryRules.Of(Item.ExpirationDate, Today);
    }
}
