@using FridgeManager.Data.Enums
@implements IAsyncDisposable

<div class="filter-bar">
    <div class="filter-bar-row">
        <div class="fm-field filter-search">
            <label for="food-search">Search by name</label>
            <input id="food-search" class="fm-input" type="text" placeholder="Search…"
                   @bind="Filter.Search" @bind:event="oninput" @bind:after="OnSearchAfter" />
        </div>
        <div class="fm-field filter-category">
            <label for="food-category">Category</label>
            <select id="food-category" class="fm-input" value="@(Filter.Category?.ToString() ?? "")" @onchange="OnCategory">
                <option value="">All categories</option>
                @foreach (var category in Enum.GetValues<FoodCategory>())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="fm-field filter-shelf">
            <label for="food-shelf">Shelf</label>
            <select id="food-shelf" class="fm-input" value="@(Filter.ShelfId?.ToString() ?? "")" @onchange="OnShelf">
                <option value="">All shelves</option>
                @foreach (var shelf in Shelves)
                {
                    <option @key="shelf.ShelfId" value="@shelf.ShelfId">@shelf.Name</option>
                }
            </select>
        </div>
        <div class="fm-field filter-status">
            <label for="food-status">Status</label>
            <select id="food-status" class="fm-input" value="@Filter.Status" @onchange="OnStatus">
                @foreach (var status in Enum.GetValues<FoodStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="fm-field filter-expiry">
            <label for="food-expiry">Expiry</label>
            <select id="food-expiry" class="fm-input" value="@(Filter.Expiry?.ToString() ?? "")" @onchange="OnExpiry">
                <option value="">Any expiry</option>
                <option value="@ExpiryState.Normal">Normal</option>
                <option value="@ExpiryState.ExpiringSoon">Expiring soon</option>
                <option value="@ExpiryState.Expired">Expired</option>
            </select>
        </div>
        <div class="filter-toggles">
            <label class="fm-check"><input type="checkbox" @bind="Filter.SharedOnly" @bind:after="NotifyImmediate" />Shared</label>
            <button type="button" class="fm-btn fm-btn-ghost fm-btn-sm filter-clear"
                    disabled="@(!Filter.HasClearableFilters)" @onclick="ClearFilters">
                Clear
            </button>
        </div>
    </div>
    <div class="filter-hint">
        <span></span>
        <div class="filter-hint-end">
            <span class="fig">@CountLabel</span>
            <div class="filter-sort-wrap">
                <button type="button" class="fm-btn fm-btn-ghost fm-btn-sm filter-sort-trigger" title="Sort by" aria-label="Sort by @SortLabel(Filter.Sort)" @onclick="ToggleSort">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M4 3v10M4 3l-2 2M4 3l2 2M12 13V3M12 13l-2-2M12 13l2-2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>@SortLabel(Filter.Sort)</span>
                </button>
                <button type="button" class="fm-btn fm-btn-ghost fm-btn-icon" title="@(Filter.EffectiveDescending ? "Descending" : "Ascending")"
                        aria-label="@(Filter.EffectiveDescending ? "Sort descending, click for ascending" : "Sort ascending, click for descending")"
                        @onclick="ToggleDirection">
                    @if (Filter.EffectiveDescending)
                    {
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 3v10M4.5 9.5 8 13l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 13V3M4.5 6.5 8 3l3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    }
                </button>
                @if (_sortOpen)
                {
                    <div class="sort-backdrop" @onclick="CloseSort"></div>
                    <div class="sort-menu-list">
                        @foreach (var option in SortOptions)
                        {
                            <button type="button"
                                    class="sort-menu-item @(Filter.Sort == option.Value ? "is-current" : null)"
                                    @onclick="() => ChooseSort(option.Value)">
                                @option.Label
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly (FoodSort Value, string Label)[] SortOptions =
    [
        (FoodSort.Expiry, "Expiration date"),
        (FoodSort.Created, "Created"),
        (FoodSort.Updated, "Updated"),
        (FoodSort.Name, "Name"),
        (FoodSort.Owner, "Owner"),
        (FoodSort.Category, "Category")
    ];

    [Parameter, EditorRequired]
    public FoodFilter Filter { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<ShelfUsageDto> Shelves { get; set; } = [];

    [Parameter]
    public int MatchedCount { get; set; }

    [Parameter]
    public int ActiveCount { get; set; }

    [Parameter]
    public EventCallback FilterChanged { get; set; }

    private CancellationTokenSource? _searchCts;
    private bool _sortOpen;

    private string CountLabel => Filter.Status == FoodStatus.Active
        ? $"{MatchedCount} of {ActiveCount} active items"
        : $"{MatchedCount} items";

    private static string SortLabel(FoodSort sort)
        => SortOptions.FirstOrDefault(o => o.Value == sort).Label ?? "Expiration date";

    private void ToggleSort() => _sortOpen = !_sortOpen;

    private void CloseSort() => _sortOpen = false;

    private Task ChooseSort(FoodSort sort)
    {
        Filter.Sort = sort;
        Filter.SortDescending = null;
        _sortOpen = false;
        return NotifyImmediate();
    }

    private Task ToggleDirection()
    {
        Filter.SortDescending = !Filter.EffectiveDescending;
        return NotifyImmediate();
    }

    private Task ClearFilters()
    {
        Filter.ClearFilters();
        return NotifyImmediate();
    }

    private Task OnCategory(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        Filter.Category = Enum.TryParse<FoodCategory>(value, out var category) ? category : null;
        return NotifyImmediate();
    }

    private Task OnShelf(ChangeEventArgs e)
    {
        Filter.ShelfId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        return NotifyImmediate();
    }

    private Task OnStatus(ChangeEventArgs e)
    {
        Filter.Status = Enum.TryParse<FoodStatus>(e.Value?.ToString(), out var status)
            ? status
            : FoodStatus.Active;
        return NotifyImmediate();
    }

    private Task OnExpiry(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        Filter.Expiry = Enum.TryParse<ExpiryState>(value, out var expiry) ? expiry : null;
        return NotifyImmediate();
    }

    private Task NotifyImmediate() => FilterChanged.InvokeAsync();

    private async Task OnSearchAfter()
    {
        if (_searchCts is not null)
        {
            await _searchCts.CancelAsync();
            _searchCts.Dispose();
        }

        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            await FilterChanged.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_searchCts is not null)
        {
            await _searchCts.CancelAsync();
            _searchCts.Dispose();
        }
    }
}
