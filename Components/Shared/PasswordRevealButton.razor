<button type="button"
        class="fm-password-toggle"
        aria-label="@(Revealed ? "Hide password" : "Show password")"
        aria-pressed="@(Revealed ? "true" : "false")"
        @onclick="OnToggle"
        @attributes="ScriptedAttributes">
    <svg class="fm-password-eye" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8s-2.4 4.5-6.5 4.5S1.5 8 1.5 8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
    </svg>
    <svg class="fm-password-eye-off" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8s-2.4 4.5-6.5 4.5S1.5 8 1.5 8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
        <path d="M3 13 13 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
</button>

@code {
    [Parameter]
    public bool Revealed { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    private IReadOnlyDictionary<string, object>? ScriptedAttributes =>
        OnToggle.HasDelegate
            ? null
            : new Dictionary<string, object> { ["data-password-toggle"] = true };
}
