@implements IDisposable

@inject NavigationManager NavigationManager

<div class="app-nav-wrap">
    <nav class="app-nav">
        <a class="app-brand" href="/">Fridge Manager</a>
        <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="food">Food</NavLink>
        <AuthorizeView Roles="Admin">
            <NavLink href="admin/users">Users</NavLink>
        </AuthorizeView>
        <span class="app-nav-spacer"></span>
        <div class="app-nav-user">
            <AuthorizeView>
                <Authorized>
                    <span>@ShortName(context.User.Identity?.Name)</span>
                    <NavLink href="Account/Manage">Account</NavLink>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                        <button type="submit" class="app-nav-btn">Log out</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="Account/Login">Log in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

@code {
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    private static string ShortName(string? identityName)
    {
        if (string.IsNullOrEmpty(identityName))
        {
            return "";
        }

        var at = identityName.IndexOf('@');
        return at > 0 ? identityName[..at] : identityName;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
