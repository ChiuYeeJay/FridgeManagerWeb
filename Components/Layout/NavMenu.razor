@implements IDisposable

@inject NavigationManager NavigationManager

<div class="app-nav-wrap">
    <nav class="app-nav">
        <input @key="_menuEpoch" type="checkbox" id="app-nav-toggle" class="app-nav-check" />
        <div class="app-nav-bar">
            <a class="app-brand" href="/">Fridge Manager</a>
            <label class="app-nav-toggle" for="app-nav-toggle">Menu</label>
        </div>
        <label class="app-nav-backdrop" for="app-nav-toggle" aria-label="Close menu"></label>
        <div class="app-nav-links">
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="food">Food</NavLink>
            <AuthorizeView Roles="Admin">
                <NavLink href="admin/users">Users</NavLink>
            </AuthorizeView>
            <span class="app-nav-spacer"></span>
            <div class="app-nav-user">
                <AuthorizeView>
                    <Authorized>
                        <div class="app-nav-account">
                            <NavLink href="Account/Manage">Account</NavLink>
                            <span class="app-nav-username">@ShortName(context.User.Identity?.Name)</span>
                        </div>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                            <button type="submit" class="app-nav-btn">Log out</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="Account/Login">Log in</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </nav>
</div>

@code {
    private string? _currentUrl;
    private int _menuEpoch;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _menuEpoch++;
        StateHasChanged();
    }

    private static string ShortName(string? identityName)
    {
        if (string.IsNullOrEmpty(identityName))
        {
            return "";
        }

        var at = identityName.IndexOf('@');
        return at > 0 ? identityName[..at] : identityName;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
