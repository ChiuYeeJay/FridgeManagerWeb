@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="page-error">
    <div class="eyebrow">Something went wrong</div>
    <h1 class="page-title">This page hit a snag</h1>
    <p class="text-muted">An unexpected error occurred while processing your request. Try again, or go back to the dashboard.</p>
    @if (ShowRequestId)
    {
        <p class="text-muted fig" style="font-size:13px">Request ID: <code>@RequestId</code></p>
    }
    <a class="fm-btn fm-btn-primary" href="/">Back to dashboard</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
