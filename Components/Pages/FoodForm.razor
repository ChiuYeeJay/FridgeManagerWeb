@page "/food/new"
@page "/food/{Id:int}/edit"
@attribute [Authorize]

<PageTitle>@(IsEdit ? "Edit item" : "New item")</PageTitle>

@if (_loading)
{
    <p class="text-muted">Preparing the form…</p>
}
else if (_blocked is not null)
{
    <a class="fm-btn fm-btn-ghost" href="@ListState.LastListUrl">← Back to food list</a>
    <p class="text-muted" style="margin-top:16px">@_blocked</p>
}
else
{
    <div class="eyebrow">@(IsEdit ? "Edit item" : "New item")</div>
    <h1 class="page-title page-lead">@(IsEdit ? "Change what’s on the shelf" : "Put something in the fridge")</h1>

    @if (_error is not null)
    {
        <div class="fm-alert-danger" data-fm-form-alert>
            <div class="fm-alert-kicker">Could not save</div>
            <div class="fm-alert-body">@_error</div>
            @if (Insufficient)
            {
                <div class="fm-alert-hint">@RoomHint</div>
            }
        </div>
    }

    @if (_aiWarnings.Count > 0)
    {
        <div class="fm-alert-info">
            <div class="fm-alert-kicker">AI warnings</div>
            <div class="fm-alert-body">@string.Join(" ", _aiWarnings)</div>
        </div>
    }

    <EditForm @ref="_editForm" Model="Form" OnValidSubmit="SaveAsync" OnInvalidSubmit="OnInvalidSave">
        <DataAnnotationsValidator />
        <div class="form-grid">
            <aside class="form-sidebar-photo">
                <h5>Photo</h5>
                <div class="form-plate form-plate-picker @(_dragging ? "is-dragging" : null)">
                    @if (PhotoSrc is not null)
                    {
                        <img src="@PhotoSrc" alt="" @onerror="OnPhotoError" />
                    }
                    else
                    {
                        <span class="form-plate-hint">DROP A PHOTO<br>or choose a file</span>
                    }
                    <InputFile id="item-photo"
                               class="form-plate-input"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               OnChange="OnPhotoSelected"
                               @ondragenter="OnPhotoDragEnter"
                               @ondragleave="OnPhotoDragLeave" />
                </div>
                <label class="fm-btn fm-btn-secondary fm-btn-block form-photo-choose" for="item-photo">Choose file…</label>
                @if (_photoError is not null)
                {
                    <div class="field-error">@_photoError</div>
                }
                <div class="text-muted form-photo-hint">JPG, PNG or WebP · 5 MB maximum. Left empty, the category plate is used.</div>
                @if (ShowAi)
                {
                    <p class="text-muted form-photo-hint">
                        AI Autofill sends a processed copy of this photo to Google Gemini for
                        analysis. Do not use sensitive or confidential images. Always review
                        AI-generated suggestions before saving.
                    </p>
                    <button @key="_analyzeEpoch"
                            type="button"
                            class="fm-btn fm-btn-secondary fm-btn-block @(_analyzing ? "is-pending" : null)"
                            disabled="@FormBusy"
                            data-fm-busy-on-click
                            data-fm-busy-label="Analyzing photo..."
                            aria-busy="@_analyzing"
                            @onclick="AnalyzeAsync">
                        @(_analyzing ? "Analyzing photo..." : "Analyze with AI")
                    </button>
                    @if (_aiError is not null)
                    {
                        <div class="field-error">@_aiError</div>
                    }
                }
            </aside>
            <div class="form-stack">
                <div class="fm-field">
                    <div class="fm-field-heading">
                        <label for="item-name">Name</label>
                        @if (IsAi(nameof(FoodItemForm.Name)))
                        {
                            <span class="fm-tag fm-tag-accent">AI</span>
                        }
                    </div>
                    <input id="item-name" class="@FieldInputClass(nameof(FoodItemForm.Name))" type="text" maxlength="200"
                           value="@Form.Name" @oninput="OnNameInput" />
                    <div class="field-counter @(NameLength >= 200 ? "is-limit" : null)">@NameLength / 200</div>
                    <ValidationMessage For="() => Form.Name" />
                </div>
                <div class="form-two">
                    <div class="fm-field">
                        <div class="fm-field-heading">
                            <label for="item-category">Category</label>
                            @if (IsAi(nameof(FoodItemForm.Category)))
                            {
                                <span class="fm-tag fm-tag-accent">AI</span>
                            }
                        </div>
                        <InputSelect id="item-category" class="@FieldInputClass(nameof(FoodItemForm.Category))"
                                     @bind-Value="Form.Category" @bind-Value:after="MarkUserCategory">
                            @foreach (var category in Enum.GetValues<FoodCategory>())
                            {
                                <option value="@category">@category</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="fm-field">
                        <div class="fm-field-heading">
                            <span class="fm-field-label">Size</span>
                            @if (IsAi(nameof(FoodItemForm.SizeUnits)))
                            {
                                <span class="fm-tag fm-tag-accent">AI</span>
                            }
                        </div>
                        <InputRadioGroup @bind-Value="Form.SizeUnits" @bind-Value:after="MarkUserSize">
                            <div class="@SizeSegClass">
                                <label class="fm-seg-opt"><InputRadio Value="@(1)" />Small · 1</label>
                                <label class="fm-seg-opt"><InputRadio Value="@(2)" />Medium · 2</label>
                                <label class="fm-seg-opt"><InputRadio Value="@(3)" />Large · 3</label>
                            </div>
                        </InputRadioGroup>
                        <ValidationMessage For="() => Form.SizeUnits" />
                    </div>
                </div>
                <div class="form-two">
                    <div class="fm-field">
                        <div class="fm-field-heading">
                            <label for="item-expiry">Expiration date</label>
                            @if (IsAi(nameof(FoodItemForm.ExpirationDate)))
                            {
                                <span class="fm-tag fm-tag-accent">AI</span>
                            }
                        </div>
                        <InputDate id="item-expiry" class="@ExpiryInputClass"
                                   @bind-Value="Form.ExpirationDate" @bind-Value:after="MarkUserExpiry" />
                    </div>
                    <div class="fm-field">
                        <span class="fm-field-label">&nbsp;</span>
                        <div class="quick-dates">
                            <button type="button" class="@ExpiryPresetClass(IsExpiryDays(1))" @onclick="() => SetExpiryDays(1)">Tomorrow</button>
                            <button type="button" class="@ExpiryPresetClass(IsExpiryDays(3))" @onclick="() => SetExpiryDays(3)">+3 days</button>
                            <button type="button" class="@ExpiryPresetClass(IsExpiryDays(7))" @onclick="() => SetExpiryDays(7)">+1 week</button>
                            <button type="button" class="@ExpiryPresetClass(IsExpiryMonths(1))" @onclick="() => SetExpiryMonths(1)">+1 month</button>
                            <button type="button" class="@ExpiryPresetClass(IsExpiryYears(1))" @onclick="() => SetExpiryYears(1)">+1 year</button>
                        </div>
                    </div>
                </div>
                <div class="fm-field">
                    <label for="item-shelf">Shelf</label>
                    <InputSelect id="item-shelf" class="@ShelfInputClass" @bind-Value="Form.ShelfId">
                        @foreach (var shelf in _shelves)
                        {
                            <option @key="shelf.ShelfId" value="@shelf.ShelfId">@shelf.Name</option>
                        }
                    </InputSelect>
                    @if (SelectedShelf is not null)
                    {
                        <div class="capacity-line @(Insufficient ? "is-short" : null)">
                            <span class="fig">@SelectedShelf.Name: @LiveRemaining of @SelectedShelf.CapacityUnits units free@(Insufficient ? $" — not enough for {Form.SizeUnits}" : "")</span>
                            <span class="text-muted">live check</span>
                        </div>
                        <div class="bar @(Insufficient ? "bar-danger" : null)" style="margin-top:6px;height:8px">
                            <div class="bar-fill" style="width:@UsedPercent%"></div>
                        </div>
                    }
                    <ValidationMessage For="() => Form.ShelfId" />
                </div>
                <div class="fm-field">
                    <span class="fm-field-label">Shared</span>
                    <label class="fm-check">
                        <InputCheckbox @bind-Value="Form.IsShared" />
                        Anyone on the team may take some
                    </label>
                </div>
                <div class="fm-field">
                    <label for="item-position">Position note</label>
                    <InputText id="item-position" class="fm-input" @bind-Value="Form.PositionNote" placeholder="e.g. back left, behind the milk" />
                </div>
                <div class="fm-field">
                    <div class="fm-field-heading">
                        <label for="item-note">Note</label>
                        @if (IsAi(nameof(FoodItemForm.Note)))
                        {
                            <span class="fm-tag fm-tag-accent">AI</span>
                        }
                    </div>
                    <InputTextArea id="item-note" class="@FieldInputClass(nameof(FoodItemForm.Note))"
                                   @bind-Value="Form.Note" @bind-Value:after="MarkUserNote"
                                   placeholder="Anything the team should know" />
                </div>
            </div>
            <aside class="form-sidebar-actions">
                @if (_allowance is not null)
                {
                    <div class="form-allowance">
                        <h5>Your allowance</h5>
                        <div class="form-allowance-row">
                            <span>Active items</span>
                            <span class="fig">@_allowance.Used / @_allowance.Quota</span>
                        </div>
                        <div class="bar form-allowance-bar">
                            <div class="bar-fill" style="width:@AllowancePercent%"></div>
                        </div>
                        <div class="text-muted form-allowance-note">
                            @(_allowance.Used >= _allowance.Quota
                                ? "You are at your limit."
                                : $"Room for {_allowance.Quota - _allowance.Used} more.")
                        </div>
                    </div>
                }
                <div class="form-actions">
                    <button @key="_submitEpoch"
                            class="fm-btn fm-btn-primary fm-btn-block @(_saving ? "is-pending" : null)"
                            type="submit"
                            disabled="@FormBusy"
                            data-fm-busy-on-click
                            data-fm-busy-label="Saving…"
                            aria-busy="@_saving">
                        @(_saving ? "Saving…" : "Save item")
                    </button>
                    <a class="fm-btn fm-btn-secondary fm-btn-block" href="@CancelHref">Cancel</a>
                </div>
            </aside>
        </div>
    </EditForm>
}
