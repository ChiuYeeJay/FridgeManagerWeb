@page "/"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<div class="page-header page-header-rule">
    <div>
        <div class="eyebrow">@(_stats?.RefrigeratorName ?? "Refrigerator") · one refrigerator</div>
        <h1 class="page-title page-title-xl">The state of the fridge</h1>
    </div>
    <div class="text-muted fig page-date">@_today.ToString("dddd, d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))</div>
</div>

@if (_stats is null)
{
    <div class="stat-row">
        @for (var i = 0; i < 5; i++)
        {
            <div class="stat-cell">
                <div class="skeleton skeleton-value"></div>
                <div class="skeleton skeleton-label"></div>
            </div>
        }
    </div>
    <div class="dash-body">
        <div class="utilisation">
            <div class="skeleton skeleton-bar"></div>
        </div>
        <div class="dash-fridge">
            <div class="skeleton dash-skel"></div>
        </div>
        <div class="dash-split-rule"></div>
        <div class="dash-members">
            <div class="skeleton dash-skel"></div>
        </div>
    </div>
}
else
{
    <div class="stat-row">
        <a class="stat-cell" href="food">
            <div class="stat-value fig">@_stats.ActiveCount</div>
            <div class="stat-label">Active items</div>
        </a>
        <a class="stat-cell" href="food?mine=1">
            <div class="stat-value fig">@_myItems</div>
            <div class="stat-label">My items</div>
        </a>
        <a class="stat-cell" href="food?shared=1">
            <div class="stat-value fig">@_stats.SharedCount</div>
            <div class="stat-label">Shared items</div>
        </a>
        <a class="stat-cell" href="food?expiry=ExpiringSoon">
            <div class="stat-value fig">@_stats.ExpiringSoonCount</div>
            <div class="stat-label">Expiring soon</div>
        </a>
        <a class="stat-cell" href="food?expiry=Expired">
            <div class="stat-value stat-value-danger fig">@_stats.ExpiredCount</div>
            <div class="stat-label">Expired</div>
        </a>
    </div>

    <div class="dash-body">
        <a class="fm-btn fm-btn-primary dash-cta" href="food/new">Add an item</a>
        <div class="utilisation">
            <div class="utilisation-head">
                <h4>Overall utilisation</h4>
                <div class="fig utilisation-fig">
                    @_stats.UsedUnits <span class="text-muted utilisation-fig-unit">/ @_stats.TotalCapacity units · @_stats.UtilisationPercent%</span>
                </div>
            </div>
            <div class="bar">
                <div class="bar-fill" style="width:@_stats.UtilisationPercent%"></div>
            </div>
        </div>
        <div class="dash-fridge">
            <div class="utilisation-head dash-panel-head">
                <h4>Where things sit</h4>
                <span class="text-muted fig dash-panel-note">@_stats.UsedUnits of @_stats.TotalCapacity units · chip width ∝ size</span>
            </div>
            <FridgeElevation Shelves="_stats.Shelves" />
        </div>
        <div class="dash-split-rule"></div>
        <div class="dash-members">
            <h4 class="dash-members-title">Per-user usage</h4>
            <table class="fm-table">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th style="text-align:right">Used / quota</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in _stats.Members)
                    {
                        <tr @key="member.UserId">
                            <td>@member.Name</td>
                            <td class="num">
                                <span class="fig">@member.Used / @member.Quota</span>
                                @if (member.AtLimit)
                                {
                                    <span class="fm-tag fm-tag-danger" style="margin-left:6px">At limit</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted-note">Quota counts active items only; consumed, missing and discarded items free their unit and their slot immediately.</p>
        </div>
    </div>
}

@code {
    [Inject]
    private ICapacityService Capacity { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private DashboardStats? _stats;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.UtcNow);
    private int _myItems;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var userId = UserClaims.GetUserId(user);
        _stats = await Capacity.GetDashboardStatsAsync();
        _myItems = _stats.Members.FirstOrDefault(m => m.UserId == userId)?.Used ?? 0;
    }
}
