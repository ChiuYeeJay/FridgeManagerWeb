@page "/admin/users"
@attribute [Authorize(Policy = "AdminOnly")]

<PageTitle>Members</PageTitle>

@{
    RenderFragment<AdminUserDto> memberRow = member =>
    @<tr @key="member.UserId">
        <td class="admin-wrap">
            @if (_editingUserId == member.UserId)
            {
                <div class="admin-name">
                    <input class="fm-input admin-text-input @(_editInvalid ? "is-invalid" : null)"
                           type="text" maxlength="64"
                           value="@_editUserName"
                           @oninput="OnUserNameInput" />
                    @if (member.IsAdmin)
                    {
                        <span class="fm-tag fm-tag-outline">Admin</span>
                    }
                </div>
            }
            else
            {
                <div class="admin-name">
                    <span class="admin-name-text">@member.DisplayName</span>
                    @if (member.IsAdmin)
                    {
                        <span class="fm-tag fm-tag-outline">Admin</span>
                    }
                </div>
            }
        </td>
        <td class="admin-wrap text-muted">
            @if (_editingUserId == member.UserId)
            {
                <input class="fm-input admin-text-input @(_editInvalid ? "is-invalid" : null)"
                       type="email" maxlength="256"
                       value="@_editEmail"
                       @oninput="OnEmailInput" />
            }
            else
            {
                @member.Email
            }
        </td>
        <td class="fig">
            @if (_editingUserId == member.UserId)
            {
                <input class="fm-input fig admin-quota-input @(_editInvalid ? "is-invalid" : null)"
                       type="number" min="0" step="1"
                       value="@_editQuota"
                       @oninput="OnQuotaInput" />
            }
            else
            {
                @member.Quota
            }
        </td>
        <td>
            <span class="fig">@member.ActiveCount</span>
            @if (member.AtLimit)
            {
                <span class="fm-tag fm-tag-danger admin-full-tag">Full</span>
            }
        </td>
        <td class="admin-status-cell">
            @if (member.IsActive)
            {
                <span class="fm-tag fm-tag-neutral">Active</span>
            }
            else
            {
                <span class="fm-tag fm-tag-outline">Disabled</span>
            }
        </td>
        <td class="admin-actions-cell">
            <div class="admin-actions">
                @if (_editingUserId == member.UserId)
                {
                    <button type="button" class="fm-btn fm-btn-primary fm-btn-sm" disabled="@_busy" @onclick="SaveEditAsync">Save</button>
                    <button type="button" class="fm-btn fm-btn-secondary fm-btn-sm" disabled="@_busy" @onclick="CancelEdit">Cancel</button>
                }
                else
                {
                    <button type="button" class="fm-btn fm-btn-secondary fm-btn-sm" disabled="@_busy" @onclick="() => BeginEdit(member)">Edit</button>
                    @if (member.IsActive)
                    {
                        <button type="button" class="fm-btn fm-btn-secondary fm-btn-sm"
                                disabled="@(_busy || member.UserId == _currentUserId)"
                                @onclick="() => SetActiveAsync(member.UserId, false)">Disable</button>
                        @if (member.IsAdmin)
                        {
                            <button type="button" class="fm-btn fm-btn-secondary fm-btn-sm"
                                    disabled="@(_busy || member.UserId == _currentUserId)"
                                    @onclick="() => SetAdminAsync(member.UserId, false)">Remove admin</button>
                        }
                        else
                        {
                            <button type="button" class="fm-btn fm-btn-secondary fm-btn-sm" disabled="@_busy"
                                    @onclick="() => SetAdminAsync(member.UserId, true)">Make admin</button>
                        }
                    }
                    else
                    {
                        <button type="button" class="fm-btn fm-btn-secondary fm-btn-sm" disabled="@_busy"
                                @onclick="() => SetActiveAsync(member.UserId, true)">Enable</button>
                    }
                }
            </div>
        </td>
    </tr>;
}

<div class="admin-header">
    <div class="eyebrow">Admin only</div>
    <h1 class="page-title">Members</h1>
</div>

@if (_alert is not null)
{
    <div class="@(_alert.Success ? "fm-alert-success" : "fm-alert-danger")">
        <div class="fm-alert-kicker">@_alert.Kicker</div>
        <div class="fm-alert-body">@_alert.Body</div>
    </div>
}

@if (_users is null)
{
    <p class="text-muted">Loading members…</p>
}
else
{
    <div class="admin-table-scroll" tabindex="0" role="region" aria-label="Active members">
        <table class="fm-table admin-table">
            <thead>
                <tr>
                    <th class="admin-col-name">Username</th>
                    <th class="admin-col-email">Email</th>
                    <th class="admin-col-quota">Quota</th>
                    <th class="admin-col-count">Active items</th>
                    <th class="admin-col-status">Status</th>
                    <th class="admin-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in ActiveMembers)
                {
                    @memberRow(member)
                }
            </tbody>
        </table>
    </div>

    @if (DisabledMembers.Count > 0)
    {
        <div class="admin-disabled">
            <button type="button" class="fm-btn fm-btn-ghost admin-disabled-toggle" @onclick="ToggleDisabled">
                <span class="admin-disabled-chevron @(_disabledOpen ? "is-open" : null)" aria-hidden="true">▸</span>
                Disabled members (@DisabledMembers.Count)
            </button>
            @if (_disabledOpen)
            {
                <div class="admin-table-scroll" tabindex="0" role="region" aria-label="Disabled members">
                    <table class="fm-table admin-table">
                        <thead>
                            <tr>
                                <th class="admin-col-name">Username</th>
                                <th class="admin-col-email">Email</th>
                                <th class="admin-col-quota">Quota</th>
                                <th class="admin-col-count">Active items</th>
                                <th class="admin-col-status">Status</th>
                                <th class="admin-col-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in DisabledMembers)
                            {
                                @memberRow(member)
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <p class="admin-lede text-muted">Members are never deleted. Disabling one blocks their login and omits them from the dashboard. They stay on the food-list Owner filter so their items remain findable.</p>

    <div class="admin-split">
        <div>
            @if (!_createOpen)
            {
                <div class="admin-create-closed">
                    <button type="button" class="fm-btn fm-btn-primary" @onclick="OpenCreate">+ Create member</button>
                    <span class="text-muted admin-member-summary">@MemberSummary</span>
                </div>
            }
            else
            {
                <div class="admin-create-head">
                    <h4>Add a member</h4>
                    <button type="button" class="fm-btn fm-btn-ghost fm-btn-sm" @onclick="CloseCreate">Close</button>
                </div>
                <EditForm Model="Create" OnValidSubmit="CreateAsync">
                    <DataAnnotationsValidator />
                    <div class="admin-create-grid">
                        <div class="fm-field">
                            <label for="new-username">Username</label>
                            <InputText id="new-username" class="fm-input" @bind-Value="Create.UserName" placeholder="e.g. lena" />
                            <ValidationMessage For="() => Create.UserName" />
                        </div>
                        <div class="fm-field">
                            <label for="new-email">Email</label>
                            <InputText id="new-email" class="fm-input" @bind-Value="Create.Email" placeholder="lena@fridge.local" />
                            <ValidationMessage For="() => Create.Email" />
                        </div>
                        <div class="fm-field">
                            <label for="new-password">Password</label>
                            <div class="fm-password">
                                <InputText id="new-password" type="@(_showCreatePassword ? "text" : "password")" class="fm-input" @bind-Value="Create.Password" />
                                <PasswordRevealButton Revealed="_showCreatePassword" OnToggle="ToggleCreatePassword" />
                            </div>
                            <ValidationMessage For="() => Create.Password" />
                        </div>
                        <div class="fm-field">
                            <label for="new-quota">Quota</label>
                            <InputNumber id="new-quota" class="fm-input fig" @bind-Value="Create.Quota" />
                            <ValidationMessage For="() => Create.Quota" />
                        </div>
                    </div>
                    <label class="fm-check admin-create-admin">
                        <InputCheckbox @bind-Value="Create.IsAdmin" />
                        Administrator
                    </label>
                    <div class="admin-create-actions">
                        <button class="fm-btn fm-btn-primary" type="submit" disabled="@_busy">Create member</button>
                        <button class="fm-btn fm-btn-secondary" type="button" disabled="@_busy" @onclick="CloseCreate">Cancel</button>
                    </div>
                </EditForm>
            }
        </div>
        <aside class="admin-totals">
            <h5>Fridge total</h5>
            <div class="admin-total-row">
                <span>Quotas granted</span>
                <span class="fig">@_quotaGranted items</span>
            </div>
            <div class="admin-total-row">
                <span>Currently held</span>
                <span class="fig">@_held items</span>
            </div>
            <div class="admin-total-row admin-total-row-last">
                <span>Units in use</span>
                <span class="fig">@_usedUnits / @_totalCapacity</span>
            </div>
            <p class="text-muted admin-totals-note">Quotas may exceed shelf capacity; the capacity guard is the binding constraint. Disabled members' quotas are not counted.</p>
        </aside>
    </div>
}
