@page "/food"
@attribute [Authorize]

<PageTitle>Food</PageTitle>

<div class="page-header">
    <div>
        <div class="eyebrow">Inventory</div>
        <h1 class="page-title">Food items</h1>
    </div>
    <a class="fm-btn fm-btn-primary" href="food/new">Add an item</a>
</div>

<div class="fm-tabs">
    <button type="button" class="fm-tab @(!_filter.MineOnly ? "is-active" : null)" @onclick="() => SetMineAsync(false)">All</button>
    <button type="button" class="fm-tab @(_filter.MineOnly ? "is-active" : null)" @onclick="() => SetMineAsync(true)">My items</button>
</div>

<FoodFilterBar Filter="_filter"
               Shelves="_shelves"
               MatchedCount="_items?.Count ?? 0"
               ActiveCount="_filter.MineOnly ? _myActiveCount : _activeCount"
               FilterChanged="OnFilterChangedAsync" />

<div class="food-results">
    @if (_items is null)
    {
        <div class="food-grid">
            @for (var i = 0; i < 6; i++)
            {
                <div class="food-card food-card-skeleton">
                    <div class="food-card-plate skeleton"></div>
                    <div class="skeleton skeleton-line" style="height:20px;margin-top:10px"></div>
                    <div class="skeleton skeleton-line" style="width:50%"></div>
                </div>
            }
        </div>
    }
    else if (_items.Count == 0)
    {
        <p class="food-empty text-muted">Nothing matches these filters.</p>
    }
    else
    {
        <div class="food-grid">
            @foreach (var item in _items)
            {
                <FoodCard @key="item.Id"
                          Item="item"
                          Today="_today"
                          CurrentUserId="_userId"
                          CanDiscard="CanDiscard(item)"
                          OnDiscard="() => DiscardAsync(item.Id)" />
            }
        </div>
    }
</div>

@code {
    [Inject]
    private IInventoryService Inventory { get; set; } = default!;

    [Inject]
    private ICapacityService Capacity { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private FoodListState ListState { get; set; } = default!;

    [Inject]
    private FoodSortPreference SortPref { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "mine")]
    public string? Mine { get; set; }

    [SupplyParameterFromQuery(Name = "shared")]
    public string? Shared { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? Category { get; set; }

    [SupplyParameterFromQuery(Name = "shelf")]
    public string? Shelf { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "expiry")]
    public string? Expiry { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    public string? Dir { get; set; }

    private FoodFilter _filter = new();
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.UtcNow);
    private List<FoodItem>? _items;
    private IReadOnlyList<ShelfUsageDto> _shelves = [];
    private int _activeCount;
    private int _myActiveCount;
    private ClaimsPrincipal _user = new();
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthState).User;
        _userId = UserClaims.GetUserId(_user);
        _shelves = await Capacity.GetAllShelfUsageAsync();
        await RefreshCountsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(_userId))
        {
            _user = (await AuthState).User;
            _userId = UserClaims.GetUserId(_user);
        }

        _filter = FoodFilter.FromQuery(Q, Mine, Shared, Category, Shelf, Status, Expiry, Sort, Dir, _userId);
        ListState.LastListUrl = _filter.ToPath();
        await ReloadAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        await SortPref.WriteAsync(_filter.Sort, _filter.EffectiveDescending);
        var path = _filter.ToPath();
        if (string.Equals(ListState.LastListUrl, path, StringComparison.Ordinal))
        {
            await ReloadAsync();
            return;
        }

        Navigation.NavigateTo(path, replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var urlOmitsSort = string.IsNullOrEmpty(Sort) && string.IsNullOrEmpty(Dir);
        if (!urlOmitsSort)
        {
            await SortPref.WriteAsync(_filter.Sort, _filter.EffectiveDescending);
            return;
        }

        var saved = await SortPref.ReadAsync();
        if (saved is null)
        {
            return;
        }

        if (_filter.Sort == saved.Value.Sort && _filter.EffectiveDescending == saved.Value.Descending)
        {
            return;
        }

        _filter.Sort = saved.Value.Sort;
        _filter.SortDescending = saved.Value.Descending == FoodSortRules.DefaultDescending(saved.Value.Sort)
            ? null
            : saved.Value.Descending;
        await OnFilterChangedAsync();
    }

    private Task SetMineAsync(bool mine)
    {
        _filter.MineOnly = mine;
        return OnFilterChangedAsync();
    }

    private async Task ReloadAsync()
    {
        _items = await Inventory.GetItemsAsync(_filter);
    }

    private async Task RefreshCountsAsync()
    {
        var usage = await Capacity.GetAllUserUsageAsync();
        _activeCount = usage.Sum(u => u.Used);
        _myActiveCount = usage.FirstOrDefault(u => u.UserId == _userId)?.Used ?? 0;
    }

    private bool CanDiscard(FoodItem item)
        => item.Status == FoodStatus.Active
           && ExpiryRules.Of(item.ExpirationDate, _today) == ExpiryState.Expired
           && UserClaims.CanModify(_user, item);

    private async Task DiscardAsync(int id)
    {
        await Inventory.ChangeStatusAsync(id, FoodStatus.Discarded, _user);
        await RefreshCountsAsync();
        await ReloadAsync();
    }
}
